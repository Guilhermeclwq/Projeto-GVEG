# Render requires binding to all network interfaces. Local development can use 127.0.0.1.
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
SESSION_DAYS=7

# Required for the application server. Get these from the Turso database settings.
TURSO_DATABASE_URL=libsql://seu-banco-seu-org.turso.io
TURSO_AUTH_TOKEN=cole_seu_token_apenas_no_arquivo_local_ou_no_ambiente_do_host

# Legacy variables retained during the cutover; the GVEG server no longer reads them.
DATABASE_URL=
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua_chave